# Configuración del Sistema Super POS

# Backend
BACKEND_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Frontend
FRONTEND_URL=http://localhost:4200
FRONTEND_PORT=4200

# Base de Datos (para futura implementación)
DATABASE_URL=sqlite:///./superpos.db
# DATABASE_URL=postgresql://user:password@localhost:5432/superpos

# JWT (para futura implementación)
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Configuración de la empresa
COMPANY_NAME=Super POS
COMPANY_ADDRESS=Calle Principal 123, Ciudad
COMPANY_PHONE=+1234567890
COMPANY_EMAIL=info@superpos.com
COMPANY_TAX_ID=12345678-9

# Configuración de impuestos
DEFAULT_TAX_RATE=15

# Configuración de tickets
TICKET_PRINTER_ENABLED=false
TICKET_PRINTER_NAME=EPSON_TM_T20

# Configuración de backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30

# Configuración de logs
LOG_LEVEL=info
LOG_FILE=./logs/superpos.log
