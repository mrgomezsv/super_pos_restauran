# Configuración del Sistema Super POS
# Copia este archivo como .env y ajusta los valores según tu entorno

# ============================================
# ENTORNO
# ============================================
# Entorno actual: development, staging, production
ENVIRONMENT=development

# Modo debug (true/false)
DEBUG=true

# ============================================
# SERVIDOR
# ============================================
# Host del servidor backend
HOST=0.0.0.0

# Puerto del servidor backend
PORT=3000

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# Orígenes permitidos separados por comas
# Desarrollo: solo localhost
# Producción: dominios reales separados por comas
CORS_ORIGINS=http://localhost:4200
# Regex opcional para permitir múltiples puertos en desarrollo (ej: localhost con puertos dinámicos)
# Usa cadena vacía para deshabilitarlo en producción
CORS_ORIGIN_REGEX=http://localhost:\d+
# Ejemplo producción: CORS_ORIGINS=https://app.superpos.com,https://admin.superpos.com

# ============================================
# JWT - Autenticación
# ============================================
# ⚠️ IMPORTANTE: Cambiar en producción por una clave secreta fuerte
# Generar una clave segura: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-USE-STRONG-RANDOM-KEY

# Algoritmo JWT (HS256 recomendado)
JWT_ALGORITHM=HS256

# Expiración del access token en minutos (default: 30 minutos)
JWT_EXPIRATION_MINUTES=30

# Expiración del refresh token en días (default: 7 días)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# BASE DE DATOS
# ============================================
# SQLite (desarrollo) - formato: sqlite:///./nombre_archivo.db
DATABASE_URL=sqlite:///./superpos.db

# PostgreSQL (producción) - formato: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://postgres:password@localhost:5432/superpos

# Pool de conexiones PostgreSQL (solo para PostgreSQL)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ============================================
# CONFIGURACIÓN DE EMPRESA
# ============================================
COMPANY_NAME=Super POS
COMPANY_ADDRESS=Calle Principal 123, Ciudad
COMPANY_PHONE=+1234567890
COMPANY_EMAIL=info@superpos.com
COMPANY_TAX_ID=12345678-9

# ============================================
# CONFIGURACIÓN DE IMPUESTOS
# ============================================
DEFAULT_TAX_RATE=15.0

# ============================================
# CONFIGURACIÓN DE TICKETS/IMPRESORAS
# ============================================
TICKET_PRINTER_ENABLED=false
TICKET_PRINTER_NAME=EPSON_TM_T20

# ============================================
# CONFIGURACIÓN DE BACKUP
# ============================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30

# ============================================
# CONFIGURACIÓN DE LOGS
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/superpos.log

# ============================================
# NOTAS PARA PRODUCCIÓN
# ============================================
# 1. Cambiar ENVIRONMENT=production
# 2. Cambiar DEBUG=false
# 3. Generar SECRET_KEY fuerte y único
# 4. Configurar DATABASE_URL para PostgreSQL
# 5. Configurar CORS_ORIGINS con dominios reales
# 6. Revisar todos los valores sensibles
